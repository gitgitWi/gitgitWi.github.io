---
import * as stylex from '@stylexjs/stylex';

import { heroVisualStyles } from './HeroVisual.stylex.ts';
---

<div {...stylex.attrs(heroVisualStyles.root)} data-hero-visual>
  <div {...stylex.attrs(heroVisualStyles.fallback)} aria-hidden="true">
    <svg viewBox="0 0 400 400" width="100%" height="100%" role="presentation">
      <defs>
        <radialGradient id="hero-mint-glow" cx="50%" cy="45%" r="55%">
          <stop offset="0%" stop-color="#DDF4E9" stop-opacity="0.9"></stop>
          <stop offset="70%" stop-color="#16A36A" stop-opacity="0.25"></stop>
          <stop offset="100%" stop-color="#F7F5EE" stop-opacity="0"></stop>
        </radialGradient>
        <filter id="hero-grain" x="0" y="0" width="100%" height="100%">
          <feTurbulence type="fractalNoise" baseFrequency="0.8" numOctaves="4" stitchTiles="stitch"
          ></feTurbulence>
          <feColorMatrix type="saturate" values="0"></feColorMatrix>
          <feBlend in="SourceGraphic" mode="multiply" result="blend"></feBlend>
        </filter>
      </defs>
      <ellipse cx="200" cy="210" rx="160" ry="140" fill="url(#hero-mint-glow)"></ellipse>
      <path
        d="M120 220 C160 120, 280 140, 290 230 C250 280, 150 270, 120 220 Z"
        fill="#16A36A"
        fill-opacity="0.35"
        filter="url(#hero-grain)"></path>
      <path
        d="M140 200 C180 160, 260 170, 270 240 C230 260, 170 250, 140 200 Z"
        fill="#108A59"
        fill-opacity="0.2"></path>
    </svg>
  </div>
  <slot />
</div>
