---
import * as stylex from '@stylexjs/stylex';

import { cardStyles } from './Card.stylex.ts';

type Props = {
  padding?: 'sm' | 'md';
};

const { padding = 'md' } = Astro.props;

const paddingStyles = {
  sm: cardStyles.paddingSm,
  md: cardStyles.paddingMd,
} as const;
---

<article {...stylex.attrs(cardStyles.base, paddingStyles[padding])}><slot /></article>
