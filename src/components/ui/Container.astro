---
import * as stylex from '@stylexjs/stylex';

import { containerStyles } from './Container.stylex.ts';

type Props = {
  width?: 'default' | 'narrow' | 'wide';
};

const { width = 'default' } = Astro.props;

const widthStyles = {
  default: containerStyles.widthDefault,
  narrow: containerStyles.widthNarrow,
  wide: containerStyles.widthWide,
} as const;
---

<div {...stylex.attrs(containerStyles.base, widthStyles[width])}><slot /></div>
