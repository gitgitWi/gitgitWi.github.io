---
import * as stylex from '@stylexjs/stylex';

import { textStyles } from './Text.stylex.ts';

type Props = {
  variant?: 'body' | 'muted' | 'caption' | 'label';
};

const { variant = 'body' } = Astro.props;

const variantStyles = {
  body: textStyles.body,
  muted: textStyles.muted,
  caption: textStyles.caption,
  label: textStyles.label,
} as const;
---

<p {...stylex.attrs(textStyles.base, variantStyles[variant])}><slot /></p>
