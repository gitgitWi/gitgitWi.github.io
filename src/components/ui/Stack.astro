---
import * as stylex from '@stylexjs/stylex';

import { stackStyles } from './Stack.stylex.ts';

type Props = {
  gap?: 'sm' | 'md' | 'lg' | 'xl';
};

const { gap = 'md' } = Astro.props;

const gapStyles = {
  sm: stackStyles.gapSm,
  md: stackStyles.gapMd,
  lg: stackStyles.gapLg,
  xl: stackStyles.gapXl,
} as const;
---

<div {...stylex.attrs(stackStyles.base, gapStyles[gap])}><slot /></div>
