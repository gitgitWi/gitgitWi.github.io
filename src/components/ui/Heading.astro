---
import * as stylex from '@stylexjs/stylex';

import { headingStyles } from './Heading.stylex.ts';

type Props = {
  level?: 1 | 2 | 3 | 4;
  variant?: 'default' | 'display';
};

const { level = 1, variant = 'default' } = Astro.props;

const levelStyles = {
  1: headingStyles.level1,
  2: headingStyles.level2,
  3: headingStyles.level3,
  4: headingStyles.level4,
} as const;

const Tag = `h${level}` as 'h1' | 'h2' | 'h3' | 'h4';
const variantStyle = variant === 'display' ? headingStyles.display : levelStyles[level];
---

<Tag {...stylex.attrs(headingStyles.base, variantStyle)}><slot /></Tag>
