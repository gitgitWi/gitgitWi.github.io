---
import PostCard from '../components/content/PostCard.astro';
import HeroSection from '../components/layout/HeroSection.astro';
import Button from '../components/ui/Button.astro';
import Cluster from '../components/ui/Cluster.astro';
import Heading from '../components/ui/Heading.astro';
import Stack from '../components/ui/Stack.astro';
import Text from '../components/ui/Text.astro';
import HeroCanvas from '../components/visual/HeroCanvas.tsx';
import HeroVisual from '../components/visual/HeroVisual.astro';
import { formatDisplayDate, getRecentPosts } from '../lib/content.ts';
import Page from '../layouts/Page.astro';

const recentPosts = await getRecentPosts(6);
---

<Page title="gitgitWi — Home">
  <HeroSection>
    <Stack gap="sm" slot="content">
      <Text variant="label">Technical blog · gitgitWi</Text>
      <Heading level={1} variant="display">코드를 정리하며<br />생각을 남깁니다.</Heading>
      <Text variant="muted">
        Astro, TypeScript, 디자인 시스템에 관한 글과 위키를 모아두는 개인 블로그입니다. 따뜻한
        캔버스 위에서 긴 글을 읽기 좋게, 코드는 정확하게.
      </Text>
      <Cluster gap="sm">
        <Button href="/articles" variant="primary">Browse posts</Button>
        <Button href="/til" variant="secondary">Wiki</Button>
      </Cluster>
    </Stack>
    <HeroVisual slot="visual">
      <HeroCanvas client:visible={{ rootMargin: '100px' }} />
    </HeroVisual>
  </HeroSection>

  <section>
    <Stack gap="lg">
      <Heading level={2}>최근 글</Heading>
      <div>
        {
          recentPosts.length === 0 ? (
            <Text variant="body">아직 공개된 글이 없습니다.</Text>
          ) : (
            recentPosts.map((post) => (
              <PostCard
                title={post.title}
                date={formatDisplayDate(post.pubDate)}
                summary={post.summary}
                tags={post.tags}
                href={post.href}
              />
            ))
          )
        }
      </div>
    </Stack>
  </section>
</Page>
