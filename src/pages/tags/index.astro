---
import TagList from '../../components/patterns/TagList.astro';
import Heading from '../../components/ui/Heading.astro';
import Stack from '../../components/ui/Stack.astro';
import Text from '../../components/ui/Text.astro';
import { buildTagIndex, getAllTaggedItems } from '../../lib/content.ts';
import Page from '../../layouts/Page.astro';

const items = await getAllTaggedItems();
const tags = buildTagIndex(items).map(({ slug, label }) => ({ slug, label }));
---

<Page title="Tags — gitgitWi">
  <Stack gap="lg">
    <Heading level={1}>Tags</Heading>
    <Text variant="muted">articles와 til 콜렉션에서 수집한 태그입니다.</Text>
    {
      tags.length === 0 ? (
        <Text variant="body">아직 태그가 없습니다.</Text>
      ) : (
        <TagList tags={tags} />
      )
    }
  </Stack>
</Page>
