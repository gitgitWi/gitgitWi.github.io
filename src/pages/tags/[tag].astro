---
import Card from '../../components/ui/Card.astro';
import Heading from '../../components/ui/Heading.astro';
import Stack from '../../components/ui/Stack.astro';
import Text from '../../components/ui/Text.astro';
import {
  buildTagIndex,
  filterByTag,
  formatDisplayDate,
  getAllTaggedItems,
  type ContentListItem,
} from '../../lib/content.ts';
import Page from '../../layouts/Page.astro';

export async function getStaticPaths() {
  const items = await getAllTaggedItems();
  const tags = buildTagIndex(items);
  return tags.map((tag) => ({
    params: { tag: tag.slug },
    props: {
      tag,
      posts: filterByTag(items, tag.slug),
    },
  }));
}

type Props = {
  tag: { slug: string; label: string; count: number };
  posts: ContentListItem[];
};

const { tag, posts } = Astro.props;
---

<Page title={`${tag.label} — Tags — gitgitWi`}>
  <Stack gap="lg">
    <Heading level={1}>{tag.label}</Heading>
    <Text variant="muted">
      태그 "{tag.label}"에 해당하는 글 {posts.length}개입니다.
    </Text>

    {
      posts.length === 0 ? (
        <Text variant="body">아직 글이 없습니다.</Text>
      ) : (
        <Stack gap="md">
          {
            posts.map((post) => (
              <Card padding="md">
                <Stack gap="sm">
                  <Heading level={3}>
                    <a href={post.href}>{post.title}</a>
                  </Heading>
                  <Text variant="caption">{formatDisplayDate(post.pubDate)}</Text>
                  <Text variant="body">{post.summary}</Text>
                </Stack>
              </Card>
            ))
          }
        </Stack>
      )
    }

    <Text variant="muted">
      <a href="/tags">← 전체 태그</a>
    </Text>
  </Stack>
</Page>
