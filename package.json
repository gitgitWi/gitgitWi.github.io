{
  "name": "gh-blog",
  "version": "0.1.0",
  "private": true,
  "author": "gitgitWi",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/generate-og.mjs && astro build && bunx pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check",
    "format": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:stylex": "eslint -c eslint.stylex.config.js src",
    "test": "vitest run --passWithNoTests",
    "check-links": "node scripts/check-links.mjs",
    "check-schema": "node scripts/check-schema.mjs",
    "check-leak": "node scripts/check-leak.mjs",
    "check-budget": "node scripts/check-budget.mjs",
    "check-code-blocks": "node scripts/check-code-blocks.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/markdown-satteri": "^0.4.1",
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/preact": "^6.0.5",
    "@astrojs/prism": "^4.0.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/noto-sans-kr": "^5.3.0",
    "@fontsource/pretendard": "^5.3.0",
    "@stylexjs/stylex": "0.19.0",
    "astro": "7.3.2",
    "preact": "^10.29.8",
    "prismjs": "^1.30.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-external-links": "^3.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-smartypants": "^3.0.3",
    "sharp": "0.35.4",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@storybook-astro/framework": "^1.11.0",
    "@storybook/builder-vite": "^10.6.0",
    "@stylexjs/eslint-plugin": "0.19.0",
    "@stylexjs/unplugin": "0.19.0",
    "@types/three": "^0.185.4",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.10.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "pagefind": "^1.5.2",
    "storybook": "^10.6.0",
